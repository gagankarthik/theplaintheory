# ---- Core ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32+ random bytes. Required in production: openssl rand -base64 48
SESSION_SECRET=
# Optional 32-byte base64 key for encrypting MFA secrets at rest (AES-256-GCM).
# Defaults to a key derived from SESSION_SECRET. openssl rand -base64 32
MFA_ENCRYPTION_KEY=
# Bearer token for POST /api/internal/retention (daily data-retention job). Required in production.
INTERNAL_CRON_SECRET=
# Salt for hashing truncated visitor IPs in consent receipts
IP_HASH_SALT=

# ---- Staff console (/admin) ----
# Comma-separated account emails that are always platform superadmins (bootstrap / break-glass).
# They can then grant support or analyst roles to other existing accounts in /admin/staff.
# In production, staff also need two-factor on and a two-factor-verified session to open the console.
PLATFORM_SUPERADMINS=

# ---- Drivers (defaults run fully locally with no AWS account) ----
# local | dynamodb
STORE_DRIVER=local
# local | cognito
AUTH_DRIVER=local
# local | s3
PUBLISH_DRIVER=local
# Where the local store keeps db.json and receipts/*.jsonl
LOCAL_DATA_DIR=.data

# ---- AWS (see infra/README.md for the matching stack outputs) ----
AWS_REGION=ap-south-1
DYNAMO_TABLE=plain-theory-prod
CONFIG_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
NEXT_PUBLIC_CDN_URL=
COGNITO_REGION=ap-south-1
COGNITO_CLIENT_ID=
# Only if the app client was created with a secret
COGNITO_CLIENT_SECRET=

# ---- Stripe (billing is disabled when unset) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=

# ---- Sales enquiries (/contact-sales) ----
# Optional Slack-compatible incoming webhook; leads are always saved to the store
SALES_WEBHOOK_URL=
