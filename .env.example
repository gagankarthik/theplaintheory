# Copy to .env.local for development. In production set these in Vercel (Production environment).

# ---- Core ----
# Production: https://www.theplaintheory.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32+ random bytes each: openssl rand -base64 48
SESSION_SECRET=
IP_HASH_SALT=
# Bearer token for POST /api/internal/retention (daily data-retention job)
INTERNAL_CRON_SECRET=

# ---- Drivers: local runs on this machine with no AWS; production uses dynamodb / cognito / s3 ----
STORE_DRIVER=local
AUTH_DRIVER=local
PUBLISH_DRIVER=local

# ---- AWS (ap-south-1). Outputs of the PlainTheory-Prod-* CDK stacks; see infra/README.md ----
# Vercel overrides the standard AWS_* names, so the app's keys use a PT_ prefix.
# Keys belong to the least-privilege IAM user pt-prod-vercel-app (never a personal or admin user).
PT_AWS_REGION=ap-south-1
PT_AWS_ACCESS_KEY_ID=
PT_AWS_SECRET_ACCESS_KEY=
COGNITO_REGION=ap-south-1
# Customers sign up here; Plain Theory staff use the separate staff pool (invite-only, TOTP required).
# Staff roles are the staff pool's platform-* groups. Invite the first superadmin with `npm run staff:invite`.
COGNITO_CUSTOMER_POOL_ID=
COGNITO_CUSTOMER_CLIENT_ID=
COGNITO_STAFF_POOL_ID=
COGNITO_STAFF_CLIENT_ID=
# Staff console "Trust this browser for 30 days" (Cognito remembered devices; two-factor stays required).
# Set to 1 only AFTER deploying the Identity and Access stacks with the staff pool's device tracking
# (infra/lib/auth-stack.ts). Unset or 0: no checkbox, sign-in exactly as before.
STAFF_REMEMBER_DEVICE=
# Optional: table names default to pt-prod-aps1-<table>
# DYNAMO_TABLE_CORE= DYNAMO_TABLE_RECEIPTS= DYNAMO_TABLE_TELEMETRY= DYNAMO_TABLE_AUDIT= DYNAMO_TABLE_LEADS= DYNAMO_TABLE_EPHEMERAL=
CONFIG_BUCKET=pt-prod-aps1-config-<account-id>
CLOUDFRONT_DISTRIBUTION_ID=
NEXT_PUBLIC_CDN_URL=

# ---- Email (Amazon SES): sender on the verified domain, and the configuration set from the Mail stack ----
MAIL_FROM=Plain Theory <no-reply@theplaintheory.in>
MAIL_CONFIGURATION_SET=pt-prod-mail

# ---- Real site keys (no fallbacks) ----
# Our own marketing-site banner: a site created in the dashboard. Empty = no banner.
NEXT_PUBLIC_PLAIN_SITE_KEY=
# The /demo store: a real site whose domain matches where the demo runs. Empty = /demo hidden.
NEXT_PUBLIC_DEMO_SITE_KEY=

# ---- Stripe. Prices are read live from Stripe (run `npm run stripe:sync` to create them) ----
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the endpoint https://www.theplaintheory.in/api/billing/webhook
STRIPE_WEBHOOK_SECRET=

# ---- Sales enquiries (/contact-sales): optional Slack-compatible webhook ----
SALES_WEBHOOK_URL=
