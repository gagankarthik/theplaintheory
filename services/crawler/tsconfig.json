{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    // The worker reuses the dashboard's own modules (tracker database, scan classifier, store).
    "paths": {
      "@/*": ["../../src/*"],
      "server-only": ["./src/stubs/server-only.ts"]
    }
  },
  "include": ["src", "test", "scripts", "tsup.config.ts", "vitest.config.ts"]
}
