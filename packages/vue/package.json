  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gagankarthik/theplaintheory.git",
    "directory": "packages/vue"
  },
  "homepage": "https://www.theplaintheory.in/docs#frameworks",
  "keywords": [
    "consent",
    "cmp",
    "cookie banner",
    "gdpr",
    "ccpa",
    "dpdpa",
