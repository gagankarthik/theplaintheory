{
  "name": "@theplaintheory/angular",
  "version": "1.0.0",
  "description": "Angular 17.1+ bindings for Plain Theory consent: a signals service, providePlainConsent() and the *plainConsentAllowed directive. SSR-safe.",
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.json",
    "typecheck": "ngc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@theplaintheory/consent": "^1.0.0",
    "tslib": "^2.6.0"
  },
  "peerDependencies": {
    "@angular/common": ">=17.1.0",
    "@angular/core": ">=17.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gagankarthik/theplaintheory.git",
    "directory": "packages/angular"
  },
  "homepage": "https://www.theplaintheory.in/docs#frameworks",
  "keywords": [
    "consent",
    "cmp",
    "cookie banner",
    "gdpr",
    "ccpa",
    "dpdpa",
    "angular",
    "signals"
  ]
}
